{
  "name": "dirsha-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Dirsha API server (Node.js + TypeScript + PostgreSQL). Prototype: simulated funds and test securities only.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/db/migrate-cli.ts up",
    "migrate:status": "tsx src/db/migrate-cli.ts status",
    "seed": "tsx src/db/seed.ts",
    "create-admin": "tsx src/db/create-admin-cli.ts",
    "migrate:prod": "node dist/db/migrate-cli.js up",
    "create-admin:prod": "node dist/db/create-admin-cli.js",
    "db:reset": "tsx src/db/migrate-cli.ts reset"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
