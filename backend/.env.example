# Dirsha backend configuration. Copy to `.env` and fill in values.
# This file contains PLACEHOLDERS ONLY. Never commit a real `.env`.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL connection string (placeholder values).
DATABASE_URL=postgres://dirsha:CHANGE_ME_DB_PASSWORD@localhost:5432/dirsha_dev

# Secret used to sign access tokens. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_48_xxxxxxxxxx
JWT_ACCESS_TTL_SECONDS=900

# Cost factor for password hashing (bcrypt). 12 is a sensible default.
BCRYPT_COST=12

# Comma-separated list of allowed browser origins (admin web app).
# Leave empty to allow no cross-origin browser access.
CORS_ORIGINS=http://localhost:8080

# Test-fund provisioning (simulated money). Must stay "false" outside dev/test.
# The server refuses to start if this is "true" while NODE_ENV=production.
ENABLE_TEST_FUNDS=true

# Max sign-in / registration attempts per client IP per 15 minutes.
AUTH_RATE_LIMIT_MAX=20

# AI assistant. The default mock provider is offline and safe for demos.
AI_PROVIDER=mock
# Required only when AI_PROVIDER=bedrock or gemini; never commit a real model identifier.
AI_MODEL_ID=
# Required only when AI_PROVIDER=gemini. Keep this secret and server-side.
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.5-flash-lite
# Required only when AI_PROVIDER=bedrock; AWS credentials use the default chain/IAM role.
AWS_REGION=
AI_TIMEOUT_MS=12000
AI_RATE_LIMIT_MAX=20
AI_ALLOW_MOCK_FALLBACK=false

# Used only by `npm run seed` (dev/test fake accounts). Set it in your shell, not here:
#   SEED_PASSWORD='choose-a-local-password' npm run seed
